<?xml version="1.0" encoding="utf-8"?>
<!--
  Static preview shown in the widget picker (android:previewLayout).
  Glance renders its UI with Compose at runtime, which can't be used directly
  as a preview layout, so this plain-View layout mimics KarakeepWidget.kt:
  a "Karakeep ↻" header above a list of rounded note cards.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/widget_preview_background"
    android:padding="12dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Karakeep"
            android:textColor="#FF1A1B20"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:text="↻"
            android:textColor="#FF008ECF"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="8dp" />

    <!-- Note card 1 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/widget_preview_card"
        android:paddingHorizontal="12dp"
        android:paddingVertical="10dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Glance widgets in Compose"
            android:textColor="#FF1A1B20"
            android:textSize="14sp"
            android:textStyle="bold" />

        <View
            android:layout_width="match_parent"
            android:layout_height="2dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Build home-screen widgets with Jetpack Glance and Material 3."
            android:textColor="#FF45464F"
            android:textSize="12sp"
            android:maxLines="2" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="8dp" />

    <!-- Note card 2 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/widget_preview_card"
        android:paddingHorizontal="12dp"
        android:paddingVertical="10dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Reading list"
            android:textColor="#FF1A1B20"
            android:textSize="14sp"
            android:textStyle="bold" />

        <View
            android:layout_width="match_parent"
            android:layout_height="2dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Your most recent Karakeep bookmarks, a tap away."
            android:textColor="#FF45464F"
            android:textSize="12sp"
            android:maxLines="2" />
    </LinearLayout>

</LinearLayout>
